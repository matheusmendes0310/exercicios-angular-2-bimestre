{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "exercicio-01": {
      "projectType": "application",
      "root": "projects/exercicio-01",
      "sourceRoot": "projects/exercicio-01/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/exercicio-01/src/main.ts",
            "index": "projects/exercicio-01/src/index.html",
            "tsConfig": "projects/exercicio-01/tsconfig.app.json",
            "outputPath": "dist/exercicio-01",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/exercicio-01/public"
              }
            ],
            "styles": [
              "styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "exercicio-01:build:production"
            },
            "development": {
              "buildTarget": "exercicio-01:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
